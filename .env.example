# Copy this file to .env and replace the placeholder values.
# Obtain a bot token from @BotFather.
TELEGRAM_TOKEN="YOUR_TELEGRAM_BOT_TOKEN_HERE"

# Comma-separated numeric Telegram user IDs for bot administrators.
ADMIN_IDS="123456789"

# Optional: 0 disables error logging to a Telegram channel.
LOG_CHANNEL_ID="0"

# Optional rate-limiting interval in seconds (default: 60).
MIN_INTERVAL_BETWEEN_FILES="60"
